# Copy this file to .env and fill in what you need.

# Whisper model: tiny, base, small, medium, large-v3
# Larger = more accurate on Indian languages, but slower. large-v3 wants a GPU;
# on a CPU-only machine start with small or medium.
WHISPER_MODEL=large-v3

# auto, cpu or cuda
WHISPER_DEVICE=auto

# Needed only for the Sarvam engine. Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3
