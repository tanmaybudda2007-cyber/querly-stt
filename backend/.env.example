# Copy this file to .env and fill in what you need.

# Whisper model: tiny, base, small, medium, large-v3
# Larger = more accurate on Indian languages, but slower. large-v3 wants a GPU;
# on a CPU-only machine start with small or medium.
WHISPER_MODEL=large-v3

# auto, cpu or cuda
WHISPER_DEVICE=auto

# Needed only for the Sarvam engine. Get a key at https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3

# ---- LLM step (llm.py) ----
# Provider: groq, gemini, sarvam or ollama
LLM_PROVIDER=groq
# Leave empty to use the provider's default model (see PROVIDERS in llm.py)
LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# Free keys: https://console.groq.com and https://aistudio.google.com
GROQ_API_KEY=
GEMINI_API_KEY=
# Ollama runs models locally, no key. Change only if it isn't on the default address.
# OLLAMA_URL=http://localhost:11434/v1
